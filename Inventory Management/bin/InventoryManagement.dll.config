<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="InventoryConnection"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=InventoryDB;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />

		<httpRuntime targetFramework="4.8" />

	</system.web>

</configuration>