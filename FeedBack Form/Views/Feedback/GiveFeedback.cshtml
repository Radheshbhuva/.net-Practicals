
@model FeedbackManagement.Models.Feedback

<h2>Give Feedback</h2>

<style>
    .form-row {
        margin-bottom: 15px;
    }

        .form-row label {
            display: block;
            margin-bottom: 5px;
        }

        .form-row input[type="text"],
        .form-row textarea,
        .form-row select {
            width: 300px;
            padding: 7px;
            box-sizing: border-box;
        }

    .error {
        color: red;
    }

    .rating-box {
        width: 300px;
        box-sizing: border-box;
        border: 1px solid #999;
        border-radius: 3px;
        padding: 5px 10px;
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        align-items: center;
    }

        .rating-box input {
            display: none;
        }

        .rating-box label {
            display: inline-block;
            font-size: 32px;
            color: #ccc;
            cursor: pointer;
            margin: 0 3px;
            line-height: 1.3;
        }

            .rating-box label:hover,
            .rating-box label:hover ~ label,
            .rating-box input:checked ~ label {
                color: #FFD700;
            }

    .submit-button {
        padding: 8px 14px;
        cursor: pointer;
    }
</style>

@using (Html.BeginForm("GiveFeedback", "Feedback", FormMethod.Post))
{
    <div class="form-row">
        @Html.LabelFor(m => m.EnrollmentNo)
        @Html.TextBoxFor(m => m.EnrollmentNo)
        @Html.ValidationMessageFor(
            m => m.EnrollmentNo, "", new { @class = "error" })
    </div>

    <div class="form-row">
        @Html.LabelFor(m => m.Name)
        @Html.TextBoxFor(m => m.Name)
        @Html.ValidationMessageFor(
            m => m.Name, "", new { @class = "error" })
    </div>

    <div class="form-row">
        @Html.LabelFor(m => m.Subject)
        @Html.TextBoxFor(m => m.Subject)
        @Html.ValidationMessageFor(
            m => m.Subject, "", new { @class = "error" })
    </div>

    <div class="form-row">
        <label>Rating</label>

        <div class="rating-box">
            @Html.RadioButtonFor(m => m.Rating, 5, new { id = "star5" })
            <label for="star5" title="5 stars">&#9733;</label>

            @Html.RadioButtonFor(m => m.Rating, 4, new { id = "star4" })
            <label for="star4" title="4 stars">&#9733;</label>

            @Html.RadioButtonFor(m => m.Rating, 3, new { id = "star3" })
            <label for="star3" title="3 stars">&#9733;</label>

            @Html.RadioButtonFor(m => m.Rating, 2, new { id = "star2" })
            <label for="star2" title="2 stars">&#9733;</label>

            @Html.RadioButtonFor(m => m.Rating, 1, new { id = "star1" })
            <label for="star1" title="1 star">&#9733;</label>
        </div>

        @Html.ValidationMessageFor(
            m => m.Rating, "", new { @class = "error" })
    </div>

    <div class="form-row">
        @Html.LabelFor(m => m.Comment)
        @Html.TextAreaFor(m => m.Comment, 4, 30, null)
        @Html.ValidationMessageFor(
            m => m.Comment, "", new { @class = "error" })
    </div>

    <input type="submit"
           value="Submit Feedback"
           class="submit-button" />
}

<p>
    @Html.ActionLink("Back to Home", "Index", "Feedback")
</p>
