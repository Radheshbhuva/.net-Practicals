
@model List<FeedbackManagement.Models.Feedback>

<h2>View Feedback</h2>

@if (Model.Count == 0)
{
    <p>No feedback available.</p>
}
else
{
    <table>
        <tr>
            <th>Enrollment No</th>
            <th>Name</th>
            <th>Subject</th>
            <th>Rating</th>
            <th>Comment</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EnrollmentNo</td>
                <td>@item.Name</td>
                <td>@item.Subject</td>
                <td>@item.Rating</td>
                <td>@item.Comment</td>
            </tr>
        }
    </table>
}

<p>
    @Html.ActionLink("Back to Home", "Index", "Feedback")
</p>
